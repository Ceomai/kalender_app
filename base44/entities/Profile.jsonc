{
  "name": "Profile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "invite_code": {
      "type": "string"
    },
    "theme": {
      "type": "string",
      "enum": [
        "aurora",
        "sunset",
        "forest",
        "ocean",
        "berry",
        "mono"
      ],
      "default": "aurora"
    },
    "dark_mode": {
      "type": "boolean",
      "default": false
    },
    "week_start": {
      "type": "string",
      "enum": [
        "mon",
        "sun"
      ],
      "default": "mon"
    },
    "density": {
      "type": "string",
      "enum": [
        "comfortable",
        "compact"
      ],
      "default": "comfortable"
    },
    "default_view": {
      "type": "string",
      "enum": [
        "month",
        "week",
        "day",
        "agenda",
        "year"
      ],
      "default": "month"
    },
    "time_format": {
      "type": "string",
      "enum": [
        "24h",
        "12h"
      ],
      "default": "24h"
    },
    "email_reminders": {
      "type": "boolean",
      "default": false
    },
    "default_reminder_minutes": {
      "type": "number",
      "default": 30
    },
    "default_category": {
      "type": "string",
      "default": "personal"
    },
    "language": {
      "type": "string",
      "enum": [
        "tr",
        "en"
      ],
      "default": "tr"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}