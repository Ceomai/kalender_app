# Copy to .env and fill from Supabase Dashboard → Project Settings → API.
# The anon (public) key is safe to ship in the app; never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-public-key

# Shows "Continue with Google" once the Google provider is enabled (supabase/README.md).
# EXPO_PUBLIC_GOOGLE_SIGN_IN=1
